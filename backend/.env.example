# Salin jadi .env lalu isi. File .env tidak ikut ke GitHub.

# Koneksi database MySQL/MariaDB (kosongkan untuk pakai SQLite di data/quranapp.db)
DATABASE_URL=mysql+pymysql://quranapp:GANTI_SANDI@127.0.0.1:3306/quranapp?charset=utf8mb4

# Port backend (default 8010)
PORT=8010

# Alamat frontend yang boleh memanggil API, pisahkan dengan koma
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 1 = simpan rekaman tiap sesi ke folder rekaman/ (untuk analisis)
SIMPAN_REKAMAN=0

# --- Model AI di komputer lain (opsional) ---
# Di server utama: alamat ai_worker.py. Kosongkan kalau model AI dijalankan di komputer ini juga.
# AI_SERVER=http://100.x.x.x:8020
# Kunci rahasia yang sama di server utama dan komputer AI (buat acak, mis. python -c "import secrets;print(secrets.token_hex(24))")
# AI_KUNCI=
# Di komputer AI (ai_worker.py): alamat yang didengarkan, mis. IP Tailscale komputer itu
# AI_HOST=127.0.0.1
# AI_PORT=8020
