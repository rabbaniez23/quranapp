# Salin jadi .env lalu isi. File .env tidak ikut ke GitHub.

# Koneksi database MySQL/MariaDB (kosongkan untuk pakai SQLite di data/quranapp.db)
DATABASE_URL=mysql+pymysql://quranapp:GANTI_SANDI@127.0.0.1:3306/quranapp?charset=utf8mb4

# Port backend (default 8010)
PORT=8010

# Alamat frontend yang boleh memanggil API, pisahkan dengan koma
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 1 = simpan rekaman tiap sesi ke folder rekaman/ (untuk analisis)
SIMPAN_REKAMAN=0
